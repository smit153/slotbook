# Copy to .env for `pnpm dev` / `pnpm migrate` / `pnpm seed`.
# Start the database first:  docker compose up -d db
DATABASE_URL=postgres://slotbook:slotbook@localhost:5432/slotbook
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
PORT=3000
LOG_LEVEL=info
# false = ignore X-Forwarded-For (local). On Render set 1 (one proxy hop). Never "true".
TRUST_PROXY=false
# Password for the seeded demo host demo@slotbook.dev
SEED_HOST_PASSWORD=demo1234
# Origin the browser uses for the app (cookie-authenticated writes from other origins are refused).
# In development (NODE_ENV unset or 'development') the Vite dev server http://localhost:5173 is also allowed.
APP_ORIGIN=http://localhost:3000
# Optional: more allowed origins, comma-separated.
# EXTRA_ALLOWED_ORIGINS=
SESSION_TTL_HOURS=168
